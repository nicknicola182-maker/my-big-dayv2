  "timeline": [
    {
      "id": "t0",
      "mb": 14,
      "critical": true,
      "when": "14 months before",
      "task": "Establish the legal position first: in Scotland a registered Pagan celebrant can marry you anywhere; in England and Wales they cannot and you need a separate register office ceremony"
    },
    {
      "id": "t1",
      "mb": 13,
      "critical": true,
      "when": "13 months before",
      "task": "Find a celebrant whose tradition sits comfortably with both of yours, and meet them before booking anything"
    },
    {
      "id": "t2",
      "mb": 12,
      "critical": true,
      "when": "12 months before",
      "task": "Choose the site and get the landowner's permission in writing — walk it for vehicle access, ground conditions and a wet-weather position"
    },
    {
      "id": "t3",
      "mb": 11,
      "critical": false,
      "when": "11 months before",
      "task": "If you want a date on the wheel of the year, remember Beltane and the solstices are the busiest days in the Pagan calendar"
    },
    {
      "id": "t4",
      "mb": 10,
      "critical": true,
      "when": "10 months before",
      "task": "Decide whether the handfasting is for life or for a stated term, and agree how you will explain it to family"
    },
    {
      "id": "t5",
      "mb": 9,
      "critical": true,
      "when": "9 months before",
      "task": "Book the shelter — a yurt, tipi or marquee is a plan; an optimistic forecast is not"
    },
    {
      "id": "t6",
      "mb": 8,
      "critical": true,
      "when": "8 months before",
      "task": "Book generators, toilets and lighting for a site that has none of them"
    },
    {
      "id": "t7",
      "mb": 7,
      "critical": true,
      "when": "7 months before",
      "task": "Arrange event insurance and any licence for alcohol or amplified music"
    },
    {
      "id": "t8",
      "mb": 6,
      "critical": true,
      "when": "6 months before",
      "task": "Confirm fire permissions in writing, including what may be burned and how late"
    },
    {
      "id": "t9",
      "mb": 6,
      "critical": false,
      "when": "6 months before",
      "task": "Book the caterer and confirm proper vegan provision rather than one dish"
    },
    {
      "id": "t10",
      "mb": 5,
      "critical": false,
      "when": "5 months before",
      "task": "Make or commission the cords, and choose the colours together"
    },
    {
      "id": "t11",
      "mb": 4,
      "critical": false,
      "when": "4 months before",
      "task": "Book a photographer who works outdoors in bad light and knows not to cross a cast circle"
    },
    {
      "id": "t12",
      "mb": 4,
      "critical": true,
      "when": "4 months before",
      "task": "Book the register office appointment for the legal marriage, if you are in England or Wales"
    },
    {
      "id": "t13",
      "mb": 3,
      "critical": true,
      "when": "3 months before",
      "task": "Send invitations explaining the format, the ground underfoot and what to wear"
    },
    {
      "id": "t14",
      "mb": 3,
      "critical": true,
      "when": "3 months before",
      "task": "Write the rite with your celebrant — vows, quarter calls, who speaks and when"
    },
    {
      "id": "t15",
      "mb": 2,
      "critical": true,
      "when": "2 months before",
      "task": "Plan the wet-weather version of every part of the day, and tell suppliers what it is"
    },
    {
      "id": "t16",
      "mb": 2,
      "critical": false,
      "when": "2 months before",
      "task": "Confirm parking, shuttles and where cars go if the field is soft"
    },
    {
      "id": "t17",
      "mb": 1,
      "critical": false,
      "when": "1 months before",
      "task": "Walk the site again with the celebrant and mark the circle"
    },
    {
      "id": "t18",
      "mb": 1,
      "critical": false,
      "when": "1 months before",
      "task": "Confirm final numbers and the mead"
    },
    {
      "id": "t19",
      "mb": 0,
      "critical": true,
      "when": "0 months before",
      "task": "Register the legal marriage and collect the certificate"
    }

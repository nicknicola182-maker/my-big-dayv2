  "timeline": [
    {
      "id": "t0",
      "mb": 12,
      "critical": true,
      "when": "Sept 2026",
      "task": "Contact the church before booking anything else, and ask about dates, fees and what the church expects of you"
    },
    {
      "id": "t1",
      "mb": 12,
      "critical": true,
      "when": "Sept 2026",
      "task": "Church of England: check you can marry there, either by living in the parish or through a qualifying connection such as baptism, past residence, six months on the worship register, or a parent or grandparent married in that church"
    },
    {
      "id": "t2",
      "mb": 12,
      "critical": true,
      "when": "Sept 2026",
      "task": "If either of you has been married before, raise it at the first conversation: remarriage is at the discretion of the individual vicar or minister in most Protestant churches"
    },
    {
      "id": "t3",
      "mb": 12,
      "critical": true,
      "when": "Sept 2026",
      "task": "Book the reception venue"
    },
    {
      "id": "t4",
      "mb": 11,
      "critical": false,
      "when": "Oct 2026",
      "task": "Draft the guest list, decide daytime versus evening guests, and agree with both families who is paying for what"
    },
    {
      "id": "t27",
      "mb": 11,
      "critical": true,
      "when": "Oct 2026",
      "task": "Get the landowner's permission in writing, and walk the site — access for vehicles, water, noise, a wet-weather plan"
    },
    {
      "id": "t5",
      "mb": 10,
      "critical": false,
      "when": "Nov 2026",
      "task": "Book the photographer and videographer, and ask the vicar or minister what photography is allowed during the service"
    },
    {
      "id": "t6",
      "mb": 10,
      "critical": false,
      "when": "Nov 2026",
      "task": "Book the band or DJ for the evening"
    },
    {
      "id": "t7",
      "mb": 9,
      "critical": false,
      "when": "Dec 2026",
      "task": "Start dress shopping, allowing for order lead time plus alterations"
    },
    {
      "id": "t8",
      "mb": 9,
      "critical": false,
      "when": "Dec 2026",
      "task": "Book the florist, and ask whether the church has its own flower team and any seasonal restrictions"
    },
    {
      "id": "t28",
      "mb": 9,
      "critical": false,
      "when": "Dec 2026",
      "task": "Book the marquee or structure, generators and toilets — from-scratch venue kit gets booked out fast"
    },
    {
      "id": "t9",
      "mb": 8,
      "critical": false,
      "when": "Jan 2027",
      "task": "Send save the dates, particularly if guests are travelling"
    },
    {
      "id": "t10",
      "mb": 8,
      "critical": false,
      "when": "Jan 2027",
      "task": "Begin marriage preparation or premarital counselling if your church runs or requires it, which most US pastors do"
    },
    {
      "id": "t11",
      "mb": 6,
      "critical": false,
      "when": "Mar 2027",
      "task": "Choose hymns, readings and the form of vows with the vicar or minister, and decide whether to include Holy Communion"
    },
    {
      "id": "t12",
      "mb": 6,
      "critical": false,
      "when": "Mar 2027",
      "task": "Book the organist, and the choir and bell ringers if you want them, telling them now if the service will be filmed"
    },
    {
      "id": "t13",
      "mb": 6,
      "critical": false,
      "when": "Mar 2027",
      "task": "Order invitations"
    },
    {
      "id": "t14",
      "mb": 5,
      "critical": true,
      "when": "Apr 2027",
      "task": "Confirm your legal route: banns for most Church of England weddings, a common or special licence where banns will not work, register office notice for other denominations in England and Wales, marriage notice in Scotland, or a state licence in the US"
    },
    {
      "id": "t15",
      "mb": 5,
      "critical": true,
      "when": "Apr 2027",
      "task": "If either of you is not a British or Irish citizen without settled status, tell the vicar now, because the wedding will need a superintendent registrar's schedule instead of banns and notice can take longer"
    },
    {
      "id": "t16",
      "mb": 4,
      "critical": true,
      "when": "May 2027",
      "task": "Church of England: arrange banns at the wedding church and at the parish church where each of you lives"
    },
    {
      "id": "t17",
      "mb": 4,
      "critical": true,
      "when": "May 2027",
      "task": "Other denominations in England and Wales: give notice at your local register office at least 29 days before the wedding; the notice names the building, so settle the venue first"
    },
    {
      "id": "t18",
      "mb": 4,
      "critical": false,
      "when": "May 2027",
      "task": "Send invitations"
    },
    {
      "id": "t29",
      "mb": 4,
      "critical": true,
      "when": "May 2027",
      "task": "Confirm how the legal ceremony happens — an unlicensed site usually means a separate signing"
    },
    {
      "id": "t19",
      "mb": 3,
      "critical": true,
      "when": "Jun 2027",
      "task": "Banns are read on three Sundays in each church; go along to hear them read if you can"
    },
    {
      "id": "t20",
      "mb": 2,
      "critical": true,
      "when": "Jul 2027",
      "task": "Scotland: submit marriage notice forms to the registrar, no later than 29 days and no earlier than three months before the wedding"
    },
    {
      "id": "t21",
      "mb": 2,
      "critical": true,
      "when": "Jul 2027",
      "task": "Collect the banns certificate from your home parish and deliver it to the wedding church, without which the wedding cannot go ahead"
    },
    {
      "id": "t22",
      "mb": 2,
      "critical": false,
      "when": "Jul 2027",
      "task": "Send the order of service to the vicar or minister for checking, then print"
    },
    {
      "id": "t23",
      "mb": 1,
      "critical": true,
      "when": "Aug 2027",
      "task": "US: check your state's licence rules, since many licences expire 30 to 90 days after issue and a few states have a short waiting period, and collect it in the right window"
    },
    {
      "id": "t24",
      "mb": 1,
      "critical": true,
      "when": "Aug 2027",
      "task": "Final meeting with the vicar or minister to walk through the service, confirm the music list and settle any outstanding fees"
    },
    {
      "id": "t25",
      "mb": 0.5,
      "critical": true,
      "when": "Aug 2027",
      "task": "Rehearsal at the church with the wedding party, readers and, if possible, the musicians"
    },
    {
      "id": "t26",
      "mb": 0.25,
      "critical": true,
      "when": "Aug 2027",
      "task": "Scotland: collect the marriage schedule in person from the registrar, no more than seven days before the wedding, and put someone reliable in charge of bringing it on the day"
    }
  ],

  "timeline": [
    {
      "id": "t0",
      "mb": 14,
      "critical": true,
      "when": "Jul 2026",
      "task": "Before anything else, establish that the consent of every living biological parent on both sides can be obtained — this is the requirement most likely to stop or delay the wedding"
    },
    {
      "id": "t1",
      "mb": 13,
      "critical": true,
      "when": "Aug 2026",
      "task": "Approach parents who are not Bahá'í carefully and in person; their consent is required exactly as much as a Bahá'í parent's"
    },
    {
      "id": "t2",
      "mb": 12,
      "critical": true,
      "when": "Sept 2026",
      "task": "If a parent is estranged, untraceable or refusing, take it to your Local Spiritual Assembly early — there is a process, and it is not quick"
    },
    {
      "id": "t3",
      "mb": 11,
      "critical": true,
      "when": "Oct 2026",
      "task": "Ask the Assembly which engagement-length guidance applies to you, since the ninety-five day limit is applied to Persian believers and practice varies elsewhere"
    },
    {
      "id": "t22",
      "mb": 11,
      "critical": true,
      "when": "Oct 2026",
      "task": "Get the landowner's permission in writing, and walk the site — access for vehicles, water, noise, a wet-weather plan"
    },
    {
      "id": "t4",
      "mb": 10,
      "critical": true,
      "when": "Nov 2026",
      "task": "Apply to the Local Spiritual Assembly with the consents recorded"
    },
    {
      "id": "t5",
      "mb": 9,
      "critical": true,
      "when": "Dec 2026",
      "task": "Agree the two witnesses with the Assembly"
    },
    {
      "id": "t6",
      "mb": 9,
      "critical": true,
      "when": "Dec 2026",
      "task": "Decide the civil plan now, not later — in most countries the Bahá'í ceremony alone has no legal effect"
    },
    {
      "id": "t23",
      "mb": 9,
      "critical": false,
      "when": "Dec 2026",
      "task": "Book the marquee or structure, generators and toilets — from-scratch venue kit gets booked out fast"
    },
    {
      "id": "t7",
      "mb": 8,
      "critical": true,
      "when": "Jan 2027",
      "task": "Check whether your Bahá'í centre is registered for marriage; most are not, which means a separate civil ceremony"
    },
    {
      "id": "t8",
      "mb": 8,
      "critical": false,
      "when": "Jan 2027",
      "task": "Book the venue and, if it is approved premises, the registrar"
    },

  "timeline": [
    {
      "id": "t0",
      "mb": 12,
      "critical": true,
      "when": "Jun 2026",
      "task": "Decide the shape of the wedding with both families: which events you are having, over how many days, and whether celebrations are mixed, separated or a mixture"
    },
    {
      "id": "t1",
      "mb": 12,
      "critical": true,
      "when": "Jun 2026",
      "task": "Speak to the imam or mosque about the nikah: their requirements, availability, fees and whether they can also solemnise the civil marriage in your country"
    },
    {
      "id": "t2",
      "mb": 12,
      "critical": true,
      "when": "Jun 2026",
      "task": "Check the calendar: Ramadan makes daytime catering impractical, Eid seasons book out suppliers, and many Shia families avoid the mourning months of Muharram and Safar"
    },
    {
      "id": "t3",
      "mb": 11,
      "critical": true,
      "when": "Jul 2026",
      "task": "Book the reception venue, confirming in writing that it allows outside halal caterers, will run a dry event without penalty, and can accommodate any separation or prayer space you need"
    },
    {
      "id": "t4",
      "mb": 11,
      "critical": false,
      "when": "Jul 2026",
      "task": "Agree between the families who is hosting and paying for what — traditionally the bride's side hosts the main day and the groom's side the walima, but every family settles it differently"
    },
    {
      "id": "t5",
      "mb": 10,
      "critical": true,
      "when": "Aug 2026",
      "task": "Agree the mahr together — amount, what form it takes, and how much is prompt versus deferred — before anyone else weighs in"
    },
    {
      "id": "t6",
      "mb": 10,
      "critical": true,
      "when": "Aug 2026",
      "task": "Confirm who will act as wali and who your witnesses will be, and check your imam's expectations, which differ between schools"
    },
    {
      "id": "t7",
      "mb": 10,
      "critical": true,
      "when": "Aug 2026",
      "task": "Book the halal caterer and ask exactly how the meat is certified, not just whether it is halal"
    },
    {
      "id": "t8",
      "mb": 9,
      "critical": false,
      "when": "Sept 2026",
      "task": "Book the photographer and videographer, raising gender-separated coverage and photo-sharing rules now rather than on the day"
    },
    {
      "id": "t9",
      "mb": 9,
      "critical": false,
      "when": "Sept 2026",
      "task": "Plan the mehndi or henna night and book the henna artist for the day before it"
    },
    {
      "id": "t10",
      "mb": 8,
      "critical": true,
      "when": "Oct 2026",
      "task": "Submit the mosque's marriage application and book any required premarital counselling session"
    },
    {
      "id": "t11",
      "mb": 8,
      "critical": false,
      "when": "Oct 2026",
      "task": "Book entertainment appropriate to your family — dhol players, a zaffa troupe, nasheed singers, a DJ — and brief them on the family's expectations"
    },
    {
      "id": "t12",
      "mb": 7,
      "critical": false,
      "when": "Nov 2026",
      "task": "Start outfit shopping early if anything is being made or ordered from abroad, counting one outfit per event"
    },
    {
      "id": "t13",
      "mb": 6,
      "critical": true,
      "when": "Dec 2026",
      "task": "Sort the legal marriage: give notice at the register office in the United Kingdom, plan the licence timing in the United States, book the civil ceremony in countries where it must come first"
    },
    {
      "id": "t14",
      "mb": 6,
      "critical": false,
      "when": "Dec 2026",
      "task": "Order invitations, deciding which guests are invited to which events"
    },
    {
      "id": "t15",
      "mb": 5,
      "critical": false,
      "when": "Jan 2027",
      "task": "Book hair and make-up, requesting a female team or hijab-experienced artist if you need one"
    },
    {
      "id": "t16",
      "mb": 4,
      "critical": true,
      "when": "Feb 2027",
      "task": "Gather the nikah paperwork: identity documents, and divorce or death certificates and any Islamic divorce documentation if either of you was married before"
    },
    {
      "id": "t17",
      "mb": 4,
      "critical": false,
      "when": "Feb 2027",
      "task": "Walk the venue and plan prayer space, washing access and where maghrib falls in the running order"
    },
    {
      "id": "t18",
      "mb": 3,
      "critical": true,
      "when": "Mar 2027",
      "task": "Finalise the nikah contract with the imam: the mahr as agreed, and any conditions either of you wants written in — read every clause before the day"
    },
    {
      "id": "t19",
      "mb": 3,
      "critical": false,
      "when": "Mar 2027",
      "task": "Buy the rings, remembering that grooms generally avoid gold"
    },
    {
      "id": "t20",
      "mb": 2,
      "critical": true,
      "when": "Apr 2027",
      "task": "In the United States, collect the marriage licence inside its validity window; in the United Kingdom, confirm the notice has cleared and the registrar or authorised person is booked"
    },
    {
      "id": "t21",
      "mb": 2,
      "critical": false,
      "when": "Apr 2027",
      "task": "Confirm final menus, guest numbers per event and dietary needs with the caterer"
    },
    {
      "id": "t22",
      "mb": 1,
      "critical": false,
      "when": "May 2027",
      "task": "Agree the nikah running order with the imam: language, who gives the khutbah, how consent will be taken, and whether photography is permitted during it"
    },
    {
      "id": "t23",
      "mb": 1,
      "critical": false,
      "when": "May 2027",
      "task": "Confirm logistics for the henna night and any processions — including that the venue allows drums outside"
    },
    {
      "id": "t24",
      "mb": 0,
      "critical": true,
      "when": "Jun 2027",
      "task": "On the nikah day, bring the documents, the licence where applicable, the witnesses and the signed-off contract — nothing else about the day matters if these are missing"
    },
    {
      "id": "t25",
      "mb": 0,
      "critical": true,
      "when": "Jun 2027",
      "task": "Afterwards, collect the nikah certificate, register the marriage with the civil authority where that is a separate step, and hold the walima"
    }
  ],

  "timeline": [
    {
      "id": "t0",
      "mb": 13,
      "critical": true,
      "when": "Aug 2026",
      "task": "Talk to the clerk of your area meeting before fixing anything — the meeting's agreement is the gate everything else passes through"
    },
    {
      "id": "t1",
      "mb": 12,
      "critical": true,
      "when": "Sept 2026",
      "task": "Write formally to the area meeting asking to marry under its care"
    },
    {
      "id": "t2",
      "mb": 11,
      "critical": true,
      "when": "Oct 2026",
      "task": "If neither of you is a member, ask about attender status and what the meeting requires — a registering officer's certificate is needed at the register office if either of you is not a member"
    },
    {
      "id": "t20",
      "mb": 11,
      "critical": true,
      "when": "Oct 2026",
      "task": "Get the landowner's permission in writing, and walk the site — access for vehicles, water, noise, a wet-weather plan"
    },
    {
      "id": "t3",
      "mb": 10,
      "critical": true,
      "when": "Nov 2026",
      "task": "Agree a date with the meeting, remembering that regular meetings for worship have first claim on the building"
    },
    {
      "id": "t4",
      "mb": 9,
      "critical": true,
      "when": "Dec 2026",
      "task": "Attend your meeting for clearness with the appointed Friends"
    },
    {
      "id": "t21",
      "mb": 9,
      "critical": false,
      "when": "Dec 2026",
      "task": "Book the marquee or structure, generators and toilets — from-scratch venue kit gets booked out fast"
    },
    {
      "id": "t5",
      "mb": 8,
      "critical": false,
      "when": "Jan 2027",
      "task": "Ask the meeting directly about photography, video, flowers, alcohol and confetti rather than assuming any of them"
    },
    {
      "id": "t6",
      "mb": 8,
      "critical": false,
      "when": "Jan 2027",
      "task": "Check the meeting house capacity, access and hearing loop"
    },
    {
      "id": "t7",
      "mb": 7,
      "critical": true,
      "when": "Feb 2027",
      "task": "Commission the marriage certificate — calligraphers book up and the sheet must be ready to sign on the day"
    },
    {
      "id": "t8",
      "mb": 6,
      "critical": true,
      "when": "Mar 2027",
      "task": "Appoint the two witnesses who will sign, and confirm who is acting as registering officer"
    },
    {
      "id": "t9",
      "mb": 6,
      "critical": false,
      "when": "Mar 2027",
      "task": "Book catering, or arrange the shared meal with the meeting"
    },
    {
      "id": "t10",
      "mb": 5,
      "critical": true,
      "when": "Apr 2027",
      "task": "Send invitations with a plain explanation of Quaker worship — most guests will not know what to expect"
    },
    {
      "id": "t11",
      "mb": 4,
      "critical": false,
      "when": "May 2027",
      "task": "Book the photographer and brief them on when they may and may not move"
    },
    {
      "id": "t22",
      "mb": 4,
      "critical": true,
      "when": "May 2027",
      "task": "Confirm how the legal ceremony happens — an unlicensed site usually means a separate signing"
    },
    {
      "id": "t12",
      "mb": 3,
      "critical": true,
      "when": "Jun 2027",
      "task": "Give notice of marriage at the register office; you must have lived in the district seven days first"
    },
    {
      "id": "t13",
      "mb": 3,
      "critical": true,
      "when": "Jun 2027",
      "task": "If either of you is not a member, get the registering officer's certificate to the superintendent registrar when you give notice"
    },
    {
      "id": "t14",
      "mb": 2,
      "critical": false,
      "when": "Jul 2027",
      "task": "Confirm the room layout and seating with the meeting"
    },
    {
      "id": "t15",
      "mb": 2,
      "critical": false,
      "when": "Jul 2027",
      "task": "Arrange care for young children during the hour of worship"
    },
    {
      "id": "t16",
      "mb": 1,
      "critical": true,
      "when": "Aug 2027",
      "task": "Walk through the day with the registering officer — who speaks, when the certificate is read, how the meeting closes"
    },
    {
      "id": "t17",
      "mb": 1,
      "critical": false,
      "when": "Aug 2027",
      "task": "Confirm the shared meal, crockery and who is clearing up"
    },
    {
      "id": "t18",
      "mb": 0,
      "critical": true,
      "when": "Sept 2027",
      "task": "Bring the certificate, the register documents and pens that will not smudge for a hundred signatures"
    },
    {
      "id": "t19",
      "mb": 0,
      "critical": true,
      "when": "Sept 2027",
      "task": "After the wedding, the registering officer registers the marriage — collect your certified copy"
    }

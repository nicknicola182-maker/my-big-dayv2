  "timeline": [
    {
      "id": "t0",
      "mb": 14,
      "critical": true,
      "when": "Apr 2026",
      "task": "Speak to your parish priest before you fix a date with anyone else"
    },
    {
      "id": "t1",
      "mb": 13,
      "critical": true,
      "when": "May 2026",
      "task": "Ask which dates are unavailable: Good Friday and Holy Saturday are excluded outright, and Sundays, solemnities and the seasons of Advent, Lent and Easter carry restrictions"
    },
    {
      "id": "t2",
      "mb": 12,
      "critical": true,
      "when": "Jun 2026",
      "task": "Book the church and get the date written into the parish diary"
    },
    {
      "id": "t3",
      "mb": 12,
      "critical": true,
      "when": "Jun 2026",
      "task": "Decide with the priest whether it will be a nuptial Mass or the ceremony without Mass"
    },
    {
      "id": "t4",
      "mb": 12,
      "critical": true,
      "when": "Jun 2026",
      "task": "Book the reception venue"
    },
    {
      "id": "t5",
      "mb": 11,
      "critical": false,
      "when": "Jul 2026",
      "task": "Draft the guest list and agree with both families who is hosting and paying for what"
    },
    {
      "id": "t6",
      "mb": 10,
      "critical": false,
      "when": "Aug 2026",
      "task": "Book the photographer and videographer, and ask the parish for its written photography policy"
    },
    {
      "id": "t7",
      "mb": 10,
      "critical": false,
      "when": "Aug 2026",
      "task": "Book the band or main entertainment"
    },
    {
      "id": "t8",
      "mb": 9,
      "critical": true,
      "when": "Sept 2026",
      "task": "Find out which parish holds each of your baptismal records, especially if you were baptised abroad"
    },
    {
      "id": "t9",
      "mb": 9,
      "critical": true,
      "when": "Sept 2026",
      "task": "Enrol in the marriage preparation course, since diocesan places fill up well ahead"
    },
    {
      "id": "t10",
      "mb": 9,
      "critical": false,
      "when": "Sept 2026",
      "task": "Start shopping for the dress, allowing for a long lead time plus alterations"
    },
    {
      "id": "t32",
      "mb": 9,
      "critical": true,
      "when": "Sept 2026",
      "task": "If either of you was married before, or you are already married civilly, tell the priest at the first meeting — annulment and convalidation both take far longer than the rest of the planning"
    },
    {
      "id": "t11",
      "mb": 8,
      "critical": true,
      "when": "Oct 2026",
      "task": "If either of you is not Catholic, or was married before, ask the priest to begin the permission, dispensation or nullity process now"
    },
    {
      "id": "t12",
      "mb": 8,
      "critical": false,
      "when": "Oct 2026",
      "task": "Send save the dates, particularly if guests are travelling internationally"
    },
    {
      "id": "t13",
      "mb": 7,
      "critical": false,
      "when": "Nov 2026",
      "task": "Book the florist and confirm what the church allows in your wedding's liturgical season"
    },
    {
      "id": "t14",
      "mb": 6,
      "critical": true,
      "when": "Dec 2026",
      "task": "Complete the marriage preparation course and keep the certificate"
    },
    {
      "id": "t15",
      "mb": 6,
      "critical": true,
      "when": "Dec 2026",
      "task": "Complete the pre-nuptial enquiry with your priest, interviewed separately"
    },
    {
      "id": "t16",
      "mb": 6,
      "critical": true,
      "when": "Dec 2026",
      "task": "Request letters of freedom from every parish where you have lived six months or more since turning eighteen"
    },
    {
      "id": "t17",
      "mb": 6,
      "critical": false,
      "when": "Dec 2026",
      "task": "Choose your readings from the Lectionary options and agree them with the priest"
    },
    {
      "id": "t18",
      "mb": 6,
      "critical": true,
      "when": "Dec 2026",
      "task": "Meet the parish music director and agree every piece, including processional and recessional"
    },
    {
      "id": "t19",
      "mb": 5,
      "critical": true,
      "when": "Jan 2027",
      "task": "Request newly issued baptismal and confirmation certificates, dated within six months of the wedding"
    },
    {
      "id": "t20",
      "mb": 5,
      "critical": false,
      "when": "Jan 2027",
      "task": "Order invitations"
    },
    {
      "id": "t21",
      "mb": 4,
      "critical": false,
      "when": "Feb 2027",
      "task": "Send invitations"
    },
    {
      "id": "t22",
      "mb": 4,
      "critical": false,
      "when": "Feb 2027",
      "task": "Confirm which optional ritual elements you want, such as the arras, lazo, veil or candles, and who will bring and place them"
    },
    {
      "id": "t23",
      "mb": 3,
      "critical": true,
      "when": "Mar 2027",
      "task": "Give civil notice: the registrar in Ireland or the UK, the town hall in Italy, or check the licence window in your US state"
    },
    {
      "id": "t24",
      "mb": 3,
      "critical": false,
      "when": "Mar 2027",
      "task": "Ask your readers, gift bearers and witnesses, and confirm your sponsors or padrinos"
    },
    {
      "id": "t25",
      "mb": 3,
      "critical": false,
      "when": "Mar 2027",
      "task": "Attend the natural family planning session if your diocese requires it"
    },
    {
      "id": "t26",
      "mb": 2,
      "critical": false,
      "when": "Apr 2027",
      "task": "Send the Mass booklet text to the priest for approval before printing"
    },
    {
      "id": "t27",
      "mb": 2,
      "critical": false,
      "when": "Apr 2027",
      "task": "Send the parish photography and music rules to your suppliers in writing"
    },
    {
      "id": "t28",
      "mb": 1,
      "critical": true,
      "when": "May 2027",
      "task": "Final meeting with the priest to walk through the order of the liturgy and hand over outstanding paperwork"
    },
    {
      "id": "t29",
      "mb": 1,
      "critical": true,
      "when": "May 2027",
      "task": "Collect the civil marriage licence, watching the expiry window in the US and the one-month return deadline in Ireland"
    },
    {
      "id": "t30",
      "mb": 0.5,
      "critical": true,
      "when": "May 2027",
      "task": "Rehearsal, and hand over the offerings and the civil paperwork"
    },
    {
      "id": "t31",
      "mb": 0.25,
      "critical": false,
      "when": "May 2027",
      "task": "Go to confession before the wedding, as most couples are encouraged to do"
    }

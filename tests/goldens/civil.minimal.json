  "timeline": [
    {
      "id": "t0",
      "mb": 14,
      "critical": true,
      "when": "14 months before",
      "task": "Decide the shape of the day: register office, an approved venue with a registrar, or a celebrant-led ceremony with a separate statutory marriage (England and Wales) or a legally authorised celebrant (Scotland and Northern Ireland)"
    },
    {
      "id": "t1",
      "mb": 14,
      "critical": false,
      "when": "14 months before",
      "task": "Agree the overall budget and rough guest numbers with everyone contributing"
    },
    {
      "id": "t2",
      "mb": 13,
      "critical": true,
      "when": "13 months before",
      "task": "In England and Wales, check the registration service's availability for your date before you confirm the venue: the registrar and the venue are separate bookings and both must line up"
    },
    {
      "id": "t3",
      "mb": 12,
      "critical": true,
      "when": "12 months before",
      "task": "Book the venue, checking it is on the council's approved premises list if a registrar is marrying you there in England or Wales"
    },
    {
      "id": "t4",
      "mb": 12,
      "critical": true,
      "when": "12 months before",
      "task": "Book the registrars' attendance with the council, or book your celebrant"
    },
    {
      "id": "t5",
      "mb": 12,
      "critical": false,
      "when": "12 months before",
      "task": "Take out wedding insurance as soon as the first deposits are paid"
    },
    {
      "id": "t6",
      "mb": 11,
      "critical": false,
      "when": "11 months before",
      "task": "Book the photographer and videographer"
    },
    {
      "id": "t7",
      "mb": 10,
      "critical": false,
      "when": "10 months before",
      "task": "Book the band or DJ, checking the venue's sound limiter and finish time first"
    },
    {
      "id": "t8",
      "mb": 10,
      "critical": false,
      "when": "10 months before",
      "task": "Start outfit shopping; made-to-order dresses need six months or more plus alterations"
    },
    {
      "id": "t9",
      "mb": 9,
      "critical": false,
      "when": "9 months before",
      "task": "Send save the dates, especially if guests are travelling"
    },
    {
      "id": "t10",
      "mb": 8,
      "critical": false,
      "when": "8 months before",
      "task": "Book the florist, and the caterer if your venue is dry hire"
    },
    {
      "id": "t11",
      "mb": 8,
      "critical": true,
      "when": "8 months before",
      "task": "If marrying abroad, research that country's legal requirements, residency rules and paperwork now, and decide whether to do the legal marriage at home instead"
    },
    {
      "id": "t12",
      "mb": 7,
      "critical": false,
      "when": "7 months before",
      "task": "Start shaping the ceremony: choose readings, music and any symbolic elements, and begin the script with your celebrant if you have one"
    },
    {
      "id": "t13",
      "mb": 6,
      "critical": false,
      "when": "6 months before",
      "task": "In England and Wales, send your proposed music and readings to the registration service for approval, since religious content is not allowed and decisions vary between districts"
    },
    {
      "id": "t14",
      "mb": 5,
      "critical": false,
      "when": "5 months before",
      "task": "Order invitations"
    },
    {
      "id": "t15",
      "mb": 4,
      "critical": false,
      "when": "4 months before",
      "task": "Send invitations, making the daytime and evening guest distinction unmissable if you have one"
    },
    {
      "id": "t16",
      "mb": 4,
      "critical": true,
      "when": "4 months before",
      "task": "Give notice: in England and Wales at your local register office at least 29 days before the ceremony (valid 12 months); in Scotland submit M10 forms no later than 29 days and no earlier than 3 months before; in Northern Ireland at least 28 days before"
    },
    {
      "id": "t17",
      "mb": 3,
      "critical": false,
      "when": "3 months before",
      "task": "Buy the wedding rings, or decide you are not having them"
    },
    {
      "id": "t18",
      "mb": 3,
      "critical": false,
      "when": "3 months before",
      "task": "Hair and make-up trial, timed near a dress fitting"
    },
    {
      "id": "t19",
      "mb": 3,
      "critical": false,
      "when": "3 months before",
      "task": "Choose your two witnesses and tell them what the role involves"
    },
    {
      "id": "t20",
      "mb": 2,
      "critical": false,
      "when": "2 months before",
      "task": "Write your personal vows and share them with your celebrant, or check what additions your registrar allows"
    },
    {
      "id": "t21",
      "mb": 2,
      "critical": true,
      "when": "2 months before",
      "task": "Confirm final numbers with the caterer and the running order with the venue"
    },
    {
      "id": "t22",
      "mb": 1,
      "critical": false,
      "when": "1 months before",
      "task": "Final venue meeting: confirm registrar or celebrant arrival time, the pre-ceremony interview, and where the signing table goes"
    },
    {
      "id": "t23",
      "mb": 1,
      "critical": true,
      "when": "1 months before",
      "task": "If your main ceremony is celebrant-led in England or Wales, confirm the statutory register office booking and the witnesses attending it"
    },
    {
      "id": "t24",
      "mb": 0.5,
      "critical": true,
      "when": "0.5 months before",
      "task": "In Scotland, collect the marriage schedule in person from the register office in the seven days before the wedding; in Northern Ireland collect it no more than 14 days before"
    },
    {
      "id": "t25",
      "mb": 0.25,
      "critical": false,
      "when": "0.25 months before",
      "task": "Walk through the ceremony space, or hold a short rehearsal if your celebrant offers one"
    }
  ],

  "timeline": [
    {
      "id": "t0",
      "mb": 14,
      "critical": true,
      "when": "Jul 2026",
      "task": "Sit down with your pandit or astrologer and fix the muhurat before you book anything else, since the auspicious date and time anchor every other booking"
    },
    {
      "id": "t1",
      "mb": 14,
      "critical": true,
      "when": "Jul 2026",
      "task": "Ask which periods are closed for weddings in your community's calendar, such as Chaturmas, adhik maas and periods when Venus or Jupiter is combust, so you know which months are simply unavailable"
    },
    {
      "id": "t2",
      "mb": 13,
      "critical": true,
      "when": "Aug 2026",
      "task": "Agree between the two families who is hosting and paying for what, event by event, before the big bookings are made"
    },
    {
      "id": "t3",
      "mb": 13,
      "critical": true,
      "when": "Aug 2026",
      "task": "Book the ceremony and reception venues, confirming in writing that they allow an open flame for the havan and can open at the hour your muhurat requires"
    },
    {
      "id": "t4",
      "mb": 12,
      "critical": true,
      "when": "Sept 2026",
      "task": "Book the pandit for the wedding date and the supporting pujas, since good pandits are booked out on the same auspicious dates as the venues"
    },
    {
      "id": "t5",
      "mb": 12,
      "critical": true,
      "when": "Sept 2026",
      "task": "Draw up guest lists per event with both families, since the ceremony, sangeet and reception lists usually differ"
    },
    {
      "id": "t6",
      "mb": 11,
      "critical": false,
      "when": "Oct 2026",
      "task": "Book the photographer and videographer for the full multi-day span, not just the wedding day"
    },
    {
      "id": "t29",
      "mb": 11,
      "critical": true,
      "when": "Oct 2026",
      "task": "Get the landowner's permission in writing, and walk the site — access for vehicles, water, noise, a wet-weather plan"
    },
    {
      "id": "t7",
      "mb": 10,
      "critical": true,
      "when": "Nov 2026",
      "task": "Book a caterer experienced in Indian and fully vegetarian cooking, and agree the approach to eggs, Jain and vegan requirements and alcohol with both families"
    },
    {
      "id": "t8",
      "mb": 10,
      "critical": false,
      "when": "Nov 2026",
      "task": "Book the mandap and decor company and connect them directly with the venue about the fire"
    },
    {
      "id": "t9",
      "mb": 9,
      "critical": false,
      "when": "Dec 2026",
      "task": "Start outfit shopping for the couple, allowing for a buying trip to India or long lead times on made-to-order lehengas and sherwanis"
    },
    {
      "id": "t10",
      "mb": 9,
      "critical": false,
      "when": "Dec 2026",
      "task": "Begin jewellery purchases, spreading the gold buying over the months rather than one late purchase"
    },
    {
      "id": "t30",
      "mb": 9,
      "critical": false,
      "when": "Dec 2026",
      "task": "Book the marquee or structure, generators and toilets — from-scratch venue kit gets booked out fast"
    },
    {
      "id": "t11",
      "mb": 8,
      "critical": false,
      "when": "Jan 2027",
      "task": "Book the sangeet DJ, dhol players, ceremony musicians and, if you want one, the choreographer"
    },
    {
      "id": "t12",
      "mb": 8,
      "critical": false,
      "when": "Jan 2027",
      "task": "Book the mehndi artist and the hair and make-up artist for all events, confirming they can start before dawn if the muhurat is early"
    },
    {
      "id": "t13",
      "mb": 7,
      "critical": false,
      "when": "Feb 2027",
      "task": "Reserve hotel blocks for out-of-town family across the full event span"
    },
    {
      "id": "t14",
      "mb": 6,
      "critical": false,
      "when": "Mar 2027",
      "task": "Order invitations with separate event inserts, and send save-the-dates to overseas guests who need visas and flights"
    },
    {
      "id": "t15",
      "mb": 6,
      "critical": false,
      "when": "Mar 2027",
      "task": "Fix the schedule of pre-wedding events with both families, including who hosts the haldi, mehndi and sangeet and where"
    },
    {
      "id": "t16",
      "mb": 5,
      "critical": true,
      "when": "Apr 2027",
      "task": "Check the legal position where you are marrying: whether the pandit can solemnise legally, whether the venue is registered, and whether you need a separate civil ceremony"
    },
    {
      "id": "t17",
      "mb": 4,
      "critical": true,
      "when": "May 2027",
      "task": "Walk through the ceremony with your pandit: which rituals are included, how long it will run, who performs the kanyadaan and the other family roles, and whether he will explain the rituals in English as he goes"
    },
    {
      "id": "t18",
      "mb": 4,
      "critical": false,
      "when": "May 2027",
      "task": "Collect the samagri list from the pandit and agree who is sourcing the puja items"
    },
    {
      "id": "t31",
      "mb": 4,
      "critical": true,
      "when": "May 2027",
      "task": "Confirm how the legal ceremony happens — an unlicensed site usually means a separate signing"
    },
    {
      "id": "t19",
      "mb": 3,
      "critical": true,
      "when": "Jun 2027",
      "task": "Give legal notice where required: notice of marriage in the United Kingdom, the Notice of Intended Marriage in Australia, the marriage licence application window in the United States or Canada"
    },
    {
      "id": "t20",
      "mb": 3,
      "critical": false,
      "when": "Jun 2027",
      "task": "Plan the baraat route with the venue and check whether a street procession or horse needs council or police permission"
    },
    {
      "id": "t21",
      "mb": 3,
      "critical": false,
      "when": "Jun 2027",
      "task": "Hold the menu tasting and fix the final menus per event"
    },
    {
      "id": "t22",
      "mb": 2,
      "critical": true,
      "when": "Jul 2027",
      "task": "Confirm the exact muhurat timing with the pandit and build the wedding day run sheet backwards from it"
    },
    {
      "id": "t23",
      "mb": 2,
      "critical": false,
      "when": "Jul 2027",
      "task": "Start sangeet rehearsals and confirm the performance running order"
    },
    {
      "id": "t24",
      "mb": 1,
      "critical": false,
      "when": "Aug 2027",
      "task": "Chase RSVPs per event, set the seating plan and order the mithai boxes per household"
    },
    {
      "id": "t25",
      "mb": 1,
      "critical": false,
      "when": "Aug 2027",
      "task": "Confirm every vendor against the run sheet, and order the fresh garlands and florals for delivery on the day"
    },
    {
      "id": "t26",
      "mb": 1,
      "critical": false,
      "when": "Aug 2027",
      "task": "Write a short ceremony program explaining the rituals for guests who have not attended a Hindu wedding before"
    },
    {
      "id": "t27",
      "mb": 0,
      "critical": false,
      "when": "Sept 2027",
      "task": "Hold the Ganesh puja, haldi, mehndi and sangeet on the planned days, keeping the bridal mehndi session clear of other commitments"
    },
    {
      "id": "t28",
      "mb": 0,
      "critical": true,
      "when": "Sept 2027",
      "task": "After the wedding, register the marriage and obtain the certificate: with the state registrar in India, or confirm the licence or schedule has been returned where the pandit solemnised legally"
    }
  ],

  "timeline": [
    {
      "id": "t0",
      "mb": 15,
      "critical": true,
      "when": "15 months before",
      "task": "Speak to your gurdwara before booking anything else: confirm they will conduct your Anand Karaj, what declarations they require, and how their diary works"
    },
    {
      "id": "t1",
      "mb": 14,
      "critical": true,
      "when": "14 months before",
      "task": "If one of you is not Sikh, have the conversation with the gurdwara committee now: practice varies, some require the non-Sikh partner to formally adopt the Sikh faith, and alternatives such as a civil marriage followed by an ardas of blessing exist"
    },
    {
      "id": "t2",
      "mb": 13,
      "critical": true,
      "when": "13 months before",
      "task": "Fix the date and book the gurdwara slot; any day is religiously acceptable, so popular weekends go early for practical rather than religious reasons"
    },
    {
      "id": "t3",
      "mb": 12,
      "critical": true,
      "when": "12 months before",
      "task": "Book the reception venue, checking its capacity, its own-caterer policy and whether your bar plans fit the venue"
    },
    {
      "id": "t4",
      "mb": 12,
      "critical": false,
      "when": "12 months before",
      "task": "Book the photographer and videographer, and confirm they have worked in a gurdwara before"
    },
    {
      "id": "t5",
      "mb": 11,
      "critical": true,
      "when": "11 months before",
      "task": "Draw up the guest lists per event: gurdwara and langar, which are open and large, and the reception, which is seated and fixed"
    },
    {
      "id": "t6",
      "mb": 10,
      "critical": false,
      "when": "10 months before",
      "task": "Start outfit shopping or ordering, especially anything coming from India, and book tailoring time"
    },
    {
      "id": "t7",
      "mb": 10,
      "critical": false,
      "when": "10 months before",
      "task": "Book the caterer for the reception and agree per-head price, minimums and the vegetarian or mixed menu"
    },
    {
      "id": "t8",
      "mb": 9,
      "critical": false,
      "when": "9 months before",
      "task": "Book the DJ or band, and the dhol players for the baraat, jaggo and reception"
    },
    {
      "id": "t9",
      "mb": 8,
      "critical": true,
      "when": "8 months before",
      "task": "Meet the granthi to walk through the ceremony: the palla, the four laavan, where each family sits and stands, and what the gurdwara permits for photography and decoration"
    },
    {
      "id": "t10",
      "mb": 8,
      "critical": false,
      "when": "8 months before",
      "task": "Book the mehndi artist and the hair and make-up team, flagging the pre-dawn start on the wedding morning"
    },
    {
      "id": "t11",
      "mb": 7,
      "critical": false,
      "when": "7 months before",
      "task": "Order invitations, with separate cards or inserts for each event"
    },
    {
      "id": "t12",
      "mb": 6,
      "critical": false,
      "when": "6 months before",
      "task": "Coordinate the chooda with the bride's maternal uncle and order the kalire"
    },
    {
      "id": "t13",
      "mb": 6,
      "critical": false,
      "when": "6 months before",
      "task": "Book the ghodi or baraat car, the wedding and doli cars, and guest coaches between venues"
    },
    {
      "id": "t14",
      "mb": 5,
      "critical": true,
      "when": "5 months before",
      "task": "Sort the legal route for your country: check whether your gurdwara is registered for marriages in England and Wales, or how you will obtain the licence in the United States or Canada, or lodge the Notice of Intended Marriage in Australia"
    },
    {
      "id": "t15",
      "mb": 4,
      "critical": true,
      "when": "4 months before",
      "task": "Give civil notice or apply for the licence within your country's window, and book the registrar or register office if your gurdwara ceremony will not itself be legally binding"
    },
    {
      "id": "t16",
      "mb": 4,
      "critical": true,
      "when": "4 months before",
      "task": "Confirm langar numbers with the gurdwara and whether food must come from the gurdwara kitchen or an approved caterer"
    },
    {
      "id": "t17",
      "mb": 3,
      "critical": false,
      "when": "3 months before",
      "task": "Book the Sukhmani Sahib or Akhand Path with the gurdwara if you are holding one"
    },
    {
      "id": "t18",
      "mb": 3,
      "critical": false,
      "when": "3 months before",
      "task": "Agree the milni list with both families: which pairs of relatives will be introduced, and prepare the garlands and gifts"
    },
    {
      "id": "t19",
      "mb": 2,
      "critical": false,
      "when": "2 months before",
      "task": "Order the palla, sehra, rumals for guests, and garlands, and check the gurdwara's position on the sehra and kalgi in the darbar hall"
    },
    {
      "id": "t20",
      "mb": 2,
      "critical": true,
      "when": "2 months before",
      "task": "Plan the wedding-day schedule around the morning ceremony: baraat arrival, milni, ceremony, langar, doli, and the gap before the evening reception"
    },
    {
      "id": "t21",
      "mb": 1,
      "critical": true,
      "when": "1 months before",
      "task": "Brief non-Sikh guests: heads covered and shoes off for everyone, modest dress that works for sitting on the floor, no alcohol or tobacco anywhere on gurdwara premises, and no applause in the darbar hall"
    },
    {
      "id": "t22",
      "mb": 1,
      "critical": false,
      "when": "1 months before",
      "task": "Prepare the offerings: the gurdwara donation, envelopes for the granthi and ragis, and the deg and langar contributions"
    },
    {
      "id": "t23",
      "mb": 1,
      "critical": false,
      "when": "1 months before",
      "task": "Confirm final numbers with the reception caterer and the running order with the DJ and dhol players"
    },
    {
      "id": "t24",
      "mb": 0,
      "critical": false,
      "when": "0 months before",
      "task": "Hold the mehndi, maiyan, sangeet and jaggo in the final days, keeping the night before the ceremony from running too late: the wedding morning starts early"
    },
    {
      "id": "t25",
      "mb": 0,
      "critical": true,
      "when": "0 months before",
      "task": "After the wedding, complete the legal registration and collect your marriage certificate; in India, register under the Anand Marriage Act where your state has notified rules"
    }
  ],

  "timeline": [
    {
      "id": "t0",
      "mb": 12,
      "critical": true,
      "when": "Sept 2026",
      "task": "Check dates against the Jewish calendar before booking anything: no weddings on Shabbat or festivals, and most of the Omer and the Three Weeks are closed in traditional practice — ask your rabbi exactly which days your community permits"
    },
    {
      "id": "t1",
      "mb": 12,
      "critical": true,
      "when": "Sept 2026",
      "task": "Choose your officiant and stream early — Orthodox, Conservative/Masorti, Reform/Liberal or a secular celebrant — because it determines the paperwork, the ketubah text, the venue options and, for mixed-faith couples, who will marry you at all"
    },
    {
      "id": "t2",
      "mb": 12,
      "critical": true,
      "when": "Sept 2026",
      "task": "Book the rabbi and the ceremony venue together, and confirm the date is in the synagogue diary"
    },
    {
      "id": "t3",
      "mb": 11,
      "critical": true,
      "when": "Oct 2026",
      "task": "If either of you was previously married in a Jewish ceremony, start the get (religious divorce) now — Orthodox and Conservative rabbis cannot marry you without it, and it takes months"
    },
    {
      "id": "t4",
      "mb": 11,
      "critical": true,
      "when": "Oct 2026",
      "task": "Gather proof of Jewish status for an Orthodox marriage: parents' ketubah, a letter from a recognised rabbi, or conversion certificates — records held abroad can take a long time to obtain"
    },
    {
      "id": "t5",
      "mb": 11,
      "critical": true,
      "when": "Oct 2026",
      "task": "Book the reception venue, checking kosher catering arrangements, dance floor size for the hora, and a private room for yichud"
    },
    {
      "id": "t27",
      "mb": 11,
      "critical": true,
      "when": "Oct 2026",
      "task": "Get the landowner's permission in writing, and walk the site — access for vehicles, water, noise, a wet-weather plan"
    },
    {
      "id": "t6",
      "mb": 10,
      "critical": true,
      "when": "Nov 2026",
      "task": "Book the kosher caterer, or agree with the venue how the kitchen will be supervised or koshered — the approved-caterer list for your kashrut authority narrows the field, so move early"
    },
    {
      "id": "t7",
      "mb": 10,
      "critical": false,
      "when": "Nov 2026",
      "task": "Book the band, photographer and videographer, briefing them on the tisch, bedeken, chuppah and hora running order"
    },
    {
      "id": "t8",
      "mb": 9,
      "critical": true,
      "when": "Dec 2026",
      "task": "Apply for religious marriage authorisation: through the Office of the Chief Rabbi in the United Kingdom, your movement's equivalent elsewhere, or by planning the Rabbinate marriage file if marrying in Israel"
    },
    {
      "id": "t28",
      "mb": 9,
      "critical": false,
      "when": "Dec 2026",
      "task": "Book the marquee or structure, generators and toilets — from-scratch venue kit gets booked out fast"
    },
    {
      "id": "t9",
      "mb": 8,
      "critical": true,
      "when": "Jan 2027",
      "task": "Order the ketubah, agreeing the exact text with your rabbi before the artist starts — commissioned pieces take weeks to months"
    },
    {
      "id": "t10",
      "mb": 7,
      "critical": false,
      "when": "Feb 2027",
      "task": "Arrange the chuppah: hire one, ask the synagogue about theirs, or plan to use a family tallit on poles held by friends"
    },
    {
      "id": "t11",
      "mb": 7,
      "critical": true,
      "when": "Feb 2027",
      "task": "Begin marriage preparation with your rabbi — most movements expect a few meetings, and Orthodox communities run chatan and kallah classes"
    },
    {
      "id": "t12",
      "mb": 6,
      "critical": true,
      "when": "Mar 2027",
      "task": "Choose the two witnesses (eidim) with your rabbi's guidance — in Orthodox practice they must be religiously observant Jewish men unrelated to either of you or to each other, so do not assume close family can do it"
    },
    {
      "id": "t13",
      "mb": 6,
      "critical": false,
      "when": "Mar 2027",
      "task": "Order invitations with the Hebrew date, and confirm the Hebrew spelling of both your names and your parents' Hebrew names — the same details go on the ketubah"
    },
    {
      "id": "t14",
      "mb": 5,
      "critical": false,
      "when": "Apr 2027",
      "task": "Decide who receives honours: sheva brachot reciters, chuppah pole holders, ketubah reader — traditional weddings have many honours to give, which is a gift to both families"
    },
    {
      "id": "t15",
      "mb": 4,
      "critical": false,
      "when": "May 2027",
      "task": "Order kippot and benchers printed with your names and the date"
    },
    {
      "id": "t16",
      "mb": 4,
      "critical": false,
      "when": "May 2027",
      "task": "Buy the wedding band — a plain metal ring with no stones for the ceremony, owned by the giver — and a second one if you are doing a double-ring exchange"
    },
    {
      "id": "t29",
      "mb": 4,
      "critical": true,
      "when": "May 2027",
      "task": "Confirm how the legal ceremony happens — an unlicensed site usually means a separate signing"
    },
    {
      "id": "t17",
      "mb": 3,
      "critical": true,
      "when": "Jun 2027",
      "task": "Complete civil preliminaries: give notice at the register office in England and Wales, lodge the Notice of Intended Marriage in Australia, or diarise the marriage licence window in the United States and Canada"
    },
    {
      "id": "t18",
      "mb": 3,
      "critical": false,
      "when": "Jun 2027",
      "task": "Arrange the aufruf with your synagogue and book the kiddush"
    },
    {
      "id": "t19",
      "mb": 2,
      "critical": false,
      "when": "Jul 2027",
      "task": "Book the mikveh appointment for the days before the wedding, and a men's session for the groom if he is immersing"
    },
    {
      "id": "t20",
      "mb": 2,
      "critical": false,
      "when": "Jul 2027",
      "task": "Finalise the menu with the caterer and kashrut supervisor, remembering a meat meal means a parev dessert and cake"
    },
    {
      "id": "t21",
      "mb": 2,
      "critical": false,
      "when": "Jul 2027",
      "task": "If keeping the week of sheva brachot, line up hosts for each night and warn them about the panim chadashot — each meal needs a guest who was not at the wedding"
    },
    {
      "id": "t22",
      "mb": 1,
      "critical": true,
      "when": "Aug 2027",
      "task": "Walk through the ceremony with your rabbi: the ketubah signing, the bedeken, who walks with whom, circling, the ring declaration and the glass"
    },
    {
      "id": "t23",
      "mb": 1,
      "critical": true,
      "when": "Aug 2027",
      "task": "Confirm timings for a Shabbat-adjacent date: a Saturday night wedding cannot start until Shabbat ends, which in summer is very late — check havdalah time, supplier overtime and venue closing"
    },
    {
      "id": "t24",
      "mb": 1,
      "critical": false,
      "when": "Aug 2027",
      "task": "Arrange the yichud room with the venue, including food and drink to break the wedding-day fast if you are fasting"
    },
    {
      "id": "t25",
      "mb": 0,
      "critical": true,
      "when": "Sept 2027",
      "task": "Bring the ketubah, the ring, the wrapped glass, the kiddush cups and wine, and the kittel if wearing one — give one person the job of having them all at the venue"
    },
    {
      "id": "t26",
      "mb": 0,
      "critical": true,
      "when": "Sept 2027",
      "task": "After the wedding, make sure the marriage is civilly registered: the synagogue's secretary for marriages files it in England and Wales, the officiant returns the licence in North America, and the Rabbinate issues the certificate in Israel — confirm it has actually been done"
    }
  ],

  "timeline": [
    {
      "id": "t0",
      "mb": 15,
      "critical": true,
      "when": "15 months before",
      "task": "Fix the muhurat through the Lagna Lekhan before booking anything — the auspicious time anchors every other booking"
    },
    {
      "id": "t1",
      "mb": 14,
      "critical": true,
      "when": "14 months before",
      "task": "Find a pandit or vidhikar who performs the Jain vidhi specifically, not the Hindu one"
    },
    {
      "id": "t2",
      "mb": 13,
      "critical": true,
      "when": "13 months before",
      "task": "Book the venue, and get written permission for an open flame indoors for the fire"
    },
    {
      "id": "t3",
      "mb": 13,
      "critical": true,
      "when": "13 months before",
      "task": "Establish with both families whether root vegetables are excluded, and how strictly — it decides which caterers are even possible"
    },
    {
      "id": "t4",
      "mb": 12,
      "critical": true,
      "when": "12 months before",
      "task": "Decide the civil plan now: a Jain ceremony in England and Wales usually has no legal effect on its own"
    },
    {
      "id": "t5",
      "mb": 12,
      "critical": true,
      "when": "12 months before",
      "task": "Book a caterer who cooks Jain food properly, not an Indian caterer who will 'leave out the onion'"
    },
    {
      "id": "t6",
      "mb": 11,
      "critical": false,
      "when": "11 months before",
      "task": "Book the mandap company and let them handle the venue's fire safety between them"
    },
    {
      "id": "t7",
      "mb": 10,
      "critical": true,
      "when": "10 months before",
      "task": "Order the bridal outfit and the groom's — months, plus shipping, customs and alterations"
    },
    {
      "id": "t8",
      "mb": 10,
      "critical": false,
      "when": "10 months before",
      "task": "Ask about silk and about flower garlands, since some families avoid both on ahimsa grounds"
    },
    {
      "id": "t9",
      "mb": 9,
      "critical": false,
      "when": "9 months before",
      "task": "Book the photographer and videographer who have shot a Jain or Gujarati wedding"
    },
    {
      "id": "t10",
      "mb": 8,
      "critical": false,
      "when": "8 months before",
      "task": "Book the DJ and the choreographer, and set the sangeet rehearsal dates with both families"
    },
    {
      "id": "t11",
      "mb": 7,
      "critical": false,
      "when": "7 months before",
      "task": "Confirm the guest list across all events — the sangeet and reception lists are usually different and both larger than you think"
    },
    {
      "id": "t12",
      "mb": 6,
      "critical": true,
      "when": "6 months before",
      "task": "Book the mehndi artist and block the whole day before the wedding for the bride"
    },
    {
      "id": "t13",
      "mb": 6,
      "critical": false,
      "when": "6 months before",
      "task": "Plan the outfits for bana betai, mehndi and sangeet"
    },
    {
      "id": "t14",
      "mb": 5,
      "critical": true,
      "when": "5 months before",
      "task": "Send invitations stating clearly that the events are vegetarian and alcohol-free"
    },
    {
      "id": "t15",
      "mb": 4,
      "critical": true,
      "when": "4 months before",
      "task": "Give notice for the civil marriage"
    },
    {
      "id": "t16",
      "mb": 4,
      "critical": false,
      "when": "4 months before",
      "task": "Arrange the Mandap Mahurat and Griha Shanti at both homes"
    },
    {
      "id": "t17",
      "mb": 3,
      "critical": false,
      "when": "3 months before",
      "task": "Print a programme or brief an emcee to explain the vidhi as it goes, since much of the room will not know the Jain differences"
    },
    {
      "id": "t18",
      "mb": 3,
      "critical": true,

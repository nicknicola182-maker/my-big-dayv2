  "timeline": [
    {
      "id": "t0",
      "mb": 15,
      "critical": true,
      "when": "Mar 2026",
      "task": "Speak to your parish priest before you book anything else, and ask which dates the church cannot marry you on"
    },
    {
      "id": "t1",
      "mb": 14,
      "critical": true,
      "when": "Apr 2026",
      "task": "Check the fasting seasons against your shortlist: Great Lent and Holy Week, the Dormition fast in the first half of August, the Nativity fast, and the fixed days of 5 and 6 January, 29 August and 14 September"
    },
    {
      "id": "t2",
      "mb": 14,
      "critical": true,
      "when": "Apr 2026",
      "task": "If either of you was married before, start the ecclesiastical divorce now, because it is separate from the civil divorce and takes months"
    },
    {
      "id": "t3",
      "mb": 13,
      "critical": true,
      "when": "May 2026",
      "task": "Confirm the church is free and get the date written into the parish diary before you book a venue"
    },
    {
      "id": "t4",
      "mb": 12,
      "critical": true,
      "when": "Jun 2026",
      "task": "Agree who the koumbaros or koumbara will be and confirm they are an Orthodox Christian in good standing, since only an Orthodox sponsor may exchange the rings and the crowns"
    },
    {
      "id": "t5",
      "mb": 12,
      "critical": true,
      "when": "Jun 2026",
      "task": "Book the reception venue, checking its standing capacity as well as its seated capacity"
    },
    {
      "id": "t6",
      "mb": 11,
      "critical": true,
      "when": "Jul 2026",
      "task": "Draw up the two guest lists you actually need: the church and dinner list, and the much larger congratulations list"
    },
    {
      "id": "t7",
      "mb": 11,
      "critical": false,
      "when": "Jul 2026",
      "task": "Book the band, the photographer and the videographer, which go first at popular dates"
    },
    {
      "id": "t8",
      "mb": 10,
      "critical": false,
      "when": "Aug 2026",
      "task": "Order or arrange the stefana and lambades with the koumbaroi, and agree who is paying for what"
    },
    {
      "id": "t9",
      "mb": 9,
      "critical": true,
      "when": "Sept 2026",
      "task": "Start the paperwork: baptismal certificates for both of you, and certificates of freedom to marry or celibacy from your parish"
    },
    {
      "id": "t10",
      "mb": 8,
      "critical": true,
      "when": "Oct 2026",
      "task": "If one of you is not Orthodox, confirm with the priest that the baptism is accepted and complete any declaration about raising children in the Orthodox faith"
    },
    {
      "id": "t11",
      "mb": 8,
      "critical": false,
      "when": "Oct 2026",
      "task": "Book the caterer and confirm the per-head price, the minimum numbers and what happens if numbers rise"
    },
    {
      "id": "t12",
      "mb": 7,
      "critical": false,
      "when": "Nov 2026",
      "task": "Book the violarides or traditional musicians for the morning dressing if you are having one"
    },
    {
      "id": "t13",
      "mb": 6,
      "critical": true,
      "when": "Dec 2026",
      "task": "Begin the meetings with your priest and ask him to walk you through the service, including where you stand and what the koumbaros does"
    },
    {
      "id": "t14",
      "mb": 6,
      "critical": false,
      "when": "Dec 2026",
      "task": "Order the invitations, allowing generously for the congratulations list and for hand delivery"
    },
    {
      "id": "t15",
      "mb": 5,
      "critical": true,
      "when": "Jan 2027",
      "task": "In Cyprus, book the thalassaemia screening appointments for both of you and collect the certificates"
    },
    {
      "id": "t16",
      "mb": 4,
      "critical": true,
      "when": "Feb 2027",
      "task": "Submit your documents to the priest so he can apply to the Metropolis or Archdiocese for permission to marry"
    },
    {
      "id": "t17",
      "mb": 4,
      "critical": false,
      "when": "Feb 2027",
      "task": "Confirm the church's rules on photography, flowers, aisle runners, rice and confetti in writing"
    },
    {
      "id": "t18",
      "mb": 3,
      "critical": false,
      "when": "Mar 2027",
      "task": "Start delivering the invitations in person, family by family"
    },
    {
      "id": "t19",
      "mb": 3,
      "critical": true,
      "when": "Mar 2027",
      "task": "Give notice of marriage to the civil authority: the register office in the United Kingdom, the municipality in Greece, the Notice of Intended Marriage in Australia, the county clerk in the United States"
    },
    {
      "id": "t20",
      "mb": 3,
      "critical": true,
      "when": "Mar 2027",
      "task": "In England and Wales, confirm whether the church is registered for marriages and book the registrar if one must attend"
    },
    {
      "id": "t21",
      "mb": 2,
      "critical": true,
      "when": "Apr 2027",
      "task": "In Greece, publish the marriage announcement in a daily newspaper and collect the marriage licence from the parish or Metropolis"
    },
    {
      "id": "t22",
      "mb": 2,
      "critical": true,
      "when": "Apr 2027",
      "task": "Confirm the ecclesiastical permission has come back from the Metropolis and check its expiry date against your wedding date"
    },
    {
      "id": "t23",
      "mb": 2,
      "critical": false,
      "when": "Apr 2027",
      "task": "Book hair, make-up and the barber to come to the houses on the morning, for the mothers and attendants as well as the couple"
    },
    {
      "id": "t24",
      "mb": 1,
      "critical": false,
      "when": "May 2027",
      "task": "Buy the koufeta, the wine for the common cup and the rice or petals, within the church's rules"
    },
    {
      "id": "t25",
      "mb": 1,
      "critical": false,
      "when": "May 2027",
      "task": "Pay the church balance and put the priest's and chanter's envelopes together"
    },
    {
      "id": "t26",
      "mb": 1,
      "critical": false,
      "when": "May 2027",
      "task": "Fix the date of the krevati with the friends who will make the bed, and the eve gathering with both families"
    },
    {
      "id": "t27",
      "mb": 1,
      "critical": false,
      "when": "May 2027",
      "task": "Confirm running times with the band and agree the overtime rate in writing"
    },
    {
      "id": "t28",
      "mb": 0,
      "critical": false,
      "when": "Jun 2027",
      "task": "Hold the stolisma and the eve gathering, and give the koumbaroi the stefana, lambades and tray to bring to the church"
    },
    {
      "id": "t29",
      "mb": 0,
      "critical": true,
      "when": "Jun 2027",
      "task": "In the days after the wedding, register the marriage: within 40 days at the lixiarcheio in Greece, within 45 days with the Registrar in Cyprus"
    }
  ],
